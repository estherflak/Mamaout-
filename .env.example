# ── Supabase ────────────────────────────────────────────────────────────────
# Used by the scraper (Node.js)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Used by the frontend (Vite exposes only VITE_* vars to the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Anthropic ────────────────────────────────────────────────────────────────
# Used by the scraper to classify raw results via Claude
ANTHROPIC_API_KEY=sk-ant-...

# ── Daily reminder email (api/cron/send-reminders.js) ────────────────────────
# Service-role key lets the cron read user emails (auth.users) and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Resend API key for sending the morning-of reminder digest.
RESEND_API_KEY=re_...
# Verified sender. Until your domain is verified in Resend, "onboarding@resend.dev" works for testing.
REMINDER_FROM=MamaOut <onboarding@resend.dev>
# Link moms back into the app from the email (optional).
APP_URL=https://your-app.vercel.app
# Optional: protects the cron endpoint from being called by anyone.
CRON_SECRET=some_long_random_string
