{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/cron/scrape-tlv-digitaf.js": {
      "maxDuration": 60,
      "memory": 3009
    },
    "api/cron/scrape-beit-emanuel-rg.js": {
      "maxDuration": 60
    },
    "api/cron/scrape-ramat-gan.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape-ramat-gan",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/scrape-tlv-digitaf",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/scrape-beit-emanuel-rg",
      "schedule": "0 5 * * *"
    }
  ]
}
