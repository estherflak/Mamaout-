{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/cron/scrape-tlv-digitaf.js": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/cron/scrape-smartticket.js": {
      "maxDuration": 60
    },
    "api/cron/scrape-arbox.js": {
      "maxDuration": 60
    },
    "api/cron/scrape-ramat-gan.js": {
      "maxDuration": 60
    },
    "api/cron/send-reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape-arbox",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/scrape-ramat-gan",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/scrape-tlv-digitaf",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/scrape-smartticket",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
